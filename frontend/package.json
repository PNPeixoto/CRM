{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "api:generate": "openapi-typescript ../backend/openapi/openapi.json --output src/generated/api-schema.d.ts --alphabetize --immutable",
    "api:check": "openapi-typescript ../backend/openapi/openapi.json --output src/generated/api-schema.d.ts --alphabetize --immutable --check",
    "demo:api": "node demo/server.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "npm run test:quick",
    "test:quick": "vitest run --exclude \"**/*.e2e.test.{ts,tsx}\"",
    "test:unit": "vitest run --exclude \"**/*.test.tsx\" --exclude \"**/*.e2e.test.{ts,tsx}\"",
    "test:component": "vitest run --exclude \"**/*.test.ts\" --exclude \"**/*.e2e.test.tsx\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@stomp/stompjs": "^7.3.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "jsdom": "^28.0.0",
    "openapi-typescript": "7.13.0",
    "oxlint": "^1.71.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.18"
  }
}
