# Apenas NOMES. Valores reais nunca entram no repositório.
SPRING_PROFILES_ACTIVE=
APP_IMAGE_TAG=
APP_VERSION=
VCS_REF=
DB_URL=
DB_RUNTIME_USER=
DB_RUNTIME_PASSWORD=
DB_MIGRATION_URL=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
REDIS_URL=

# Chave de assinatura do access token (HS256). Mínimo de 32 bytes —
# a aplicação recusa subir com chave menor.
JWT_SIGNING_KEY=

# Pepper concatenado à senha antes do Argon2id. Vive só no ambiente e nunca
# no banco: quem levar o dump não consegue testar senhas offline sem ele.
# Trocar este valor invalida TODAS as senhas existentes — a troca exige
# redefinição de senha de todos os usuários, não é rotação transparente.
APP_PEPPER=

# Origens aceitas pelo CORS, separadas por vírgula. Vazio = nenhuma origem.
CORS_ALLOWED_ORIGINS=
TRUSTED_PROXY_IP_REGEX=

# Reservadas para adaptadores futuros; hoje nao sao lidas pela aplicacao.
# META_APP_SECRET=
# META_VERIFY_TOKEN=
# AGENT_ENROLLMENT_SECRET=

# Chave AES-256 (32 bytes em base64) para cifrar credenciais de canal em
# repouso — token do bot do Telegram, tokens da Meta. Separada das duas acima:
# reaproveitar uma delas faria um único vazamento comprometer senhas, sessões
# e credenciais de integração de uma vez.
# Gerar com: openssl rand -base64 32
CHANNEL_SECRET_KEY=

# Chave AES-256 (32 bytes em base64) para cifrar os segredos TOTP de MFA.
# Gerar com: openssl rand -base64 32
MFA_SECRET_KEY=

# HMAC (ao menos 32 bytes em base64) para URLs de midia com expiracao curta.
# Gerar com: openssl rand -base64 32
MEDIA_SIGNING_KEY=

# AES-256 exclusivo para segredos do conector HTTP (Bearer/API key).
# Gerar com: openssl rand -base64 32
HTTP_CONNECTOR_SECRET_KEY=

# Produção exige proxy/política de egress que também bloqueie redes privadas,
# metadata, redirects e DNS rebinding. Exemplo: http://egress-proxy:3128
HTTP_CONNECTOR_EGRESS_PROXY_URL=

# Telegram Bot API 10.2. O token do bot entra pela tela Integracoes e fica
# cifrado no banco; nao e variavel de ambiente do processo.
# Reconciliacao exige a URL HTTPS publica do backend.
TELEGRAM_RECONCILIATION_ENABLED=false
TELEGRAM_PUBLIC_BASE_URL=

# Evolution API e somente laboratorio local. O adaptador oficial de producao
# continua sendo WHATSAPP_CLOUD/Meta.
EVOLUTION_ENABLED=
EVOLUTION_API_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_BASE_URL=
TELEGRAM_MEDIA_STORAGE_PATH=

# Entrega de redefinicao de senha. Desabilitada no desenvolvimento local.
# Quando habilitada, a URL deve apontar para o provedor interno de notificacao.
PASSWORD_RESET_DELIVERY_ENABLED=false
PASSWORD_RESET_DELIVERY_URL=
